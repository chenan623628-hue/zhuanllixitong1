"""
专利-标准比对系统 V1.0
M01 工程基线模块 - 环境变量示例
"""

from app.core.schemas import ApiResponse

def create_success_response(data: dict | list | None = None, message: str = "操作成功") -> ApiResponse:
    from app.core.tracing import get_current_trace_id
    return ApiResponse(
        code=0,
        message=message,
        data=data,
        request_id=get_current_trace_id(),
    )


def create_error_response(code: int, message: str, data: dict | None = None) -> ApiResponse:
    from app.core.tracing import get_current_trace_id
    return ApiResponse(
        code=code,
        message=message,
        data=data,
        request_id=get_current_trace_id(),
    )
